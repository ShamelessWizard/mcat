#!/usr/bin/env bash
# mcat — safe cat >|>> file with mkdir -p + optional diff preview
# Usage: mcat [-o|-a] [-d] [-f] [-i] <file>
#   -o    Overwrite (default)
#   -a    Append
#   -d    Show unified diff before overwriting + ask confirmation (only with -o)
#   -f    Force: skip confirmation prompt even with -d
#   -i    Install mode: try to preserve original permissions (overwrite only)
#   -h    Show help

set -euo pipefail

mode="overwrite"
show_diff=false
force=false
preserve_mode=false

usage() {
    cat >&2 <<'EOF'
Usage: mcat [-o|-a] [-d] [-f] [-i] <file>

Options:
  -o    Overwrite the file (default)
  -a    Append to the file
  -d    Show diff preview before overwriting + ask to confirm (only useful with -o)
  -f    Force: skip confirmation even when -d is used
  -i    Preserve original file permissions (using install -m) — overwrite only
  -h    Show this help message

Examples:
  echo "new"          | mcat -o config.yml
  echo "more"         | mcat -a log/$(date +%F).txt
  sort -u list.txt    | mcat -o -d -f list.txt     # diff but no prompt
  jq . input.json     | mcat -o -i -d settings.json
EOF
    exit 2
}

while getopts ":oadfih" opt; do
    case $opt in
        o) mode="overwrite" ;;
        a) mode="append"    ;;
        d) show_diff=true   ;;
        f) force=true       ;;
        i) preserve_mode=true ;;
        h) usage            ;;
        \?)
            echo "Unknown option: -$OPTARG" >&2
            usage
            ;;
    esac
done

shift $((OPTIND-1))

[[ $# -ne 1 ]] && {
    echo "Exactly one file argument required." >&2
    usage
}

file="$1"
dir=$(dirname -- "$file")

[[ -d "$dir" ]] || mkdir -p -- "$dir" || {
    echo "Failed to create directory: $dir" >&2
    exit 1
}

tmpfile=$(mktemp --tmpdir="$dir" ".mcat.XXXXXXXXXX") || {
    echo "Failed to create temp file in $dir" >&2
    exit 1
}

# Cleanup on exit / signals
trap 'rm -f -- "$tmpfile"' EXIT INT TERM HUP

# Write to temp
if [[ $mode == "append" ]]; then
    if [[ -f "$file" ]]; then
        cp -- "$file" "$tmpfile" || exit 1
    fi
    cat >> "$tmpfile" || {
        echo "Append to temp failed" >&2
        exit 1
    }
else
    cat > "$tmpfile" || {
        echo "Write to temp failed" >&2
        exit 1
    }
fi

# Diff + confirmation only if requested and in overwrite mode
if $show_diff && [[ $mode == "overwrite" ]]; then
    if [[ -f "$file" ]]; then
        echo "─── Diff preview: ${file}  ←  new content ───" >&2
        if command -v colordiff >/dev/null 2>&1; then
            colordiff -u -- "$file" "$tmpfile" >&2 || true
        else
            diff -u -- "$file" "$tmpfile" >&2 || true
        fi
        echo "──────────────────────────────────────" >&2
    else
        echo "Note: Creating new file (no diff available)." >&2
    fi

    # Ask only if interactive tty AND not --force
    if [[ -t 0 ]] && ! $force; then
        read -r -p "Apply changes? [Y/n] " answer < /dev/tty
        case "${answer:-Y}" in
            [Yy]*|"") ;;  # proceed
            *) 
                echo "Aborted." >&2
                exit 0
                ;;
        esac
    fi
fi

# Final move / install
if [[ $mode == "append" ]] || ! $preserve_mode || [[ ! -f "$file" ]]; then
    # Simple atomic mv (append always uses mv, or when no -i, or new file)
    mv -- "$tmpfile" "$file" || {
        echo "Failed to move to $file" >&2
        exit 1
    }
else
    # Overwrite + preserve mode
    mode_str=$(stat -c %a "$file" 2>/dev/null || echo "0666")
    install -m "$mode_str" -- "$tmpfile" "$file" || {
        echo "Failed to install (preserve mode) to $file" >&2
        # Fallback to mv if install fails (e.g. non-GNU install)
        mv -- "$tmpfile" "$file" || exit 1
    }
fi

exit 0
